      _PanelItem(
        title: 'إضافة رجل أمن',
        subtitle: 'إنشاء حساب دخول جديد لرجل أمن',
        icon: Icons.security,
        color: Colors.blue,
        onTap: (ctx) => Navigator.push(
          ctx,
          MaterialPageRoute(
            builder: (_) => const AddEditUserScreen(role: 'security'),
