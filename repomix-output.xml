                const SizedBox(width: 10),
                Expanded(
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      const Text(
                        'مدة الغياب المتوقعة',
                        style: TextStyle(
                            fontSize: 12, color: Colors.grey),
                      ),
                      Text(
                        '$hoursس $minutesد',
                        style: TextStyle(
                          fontSize: 18,
                          fontWeight: FontWeight.bold,
                          color: _plannedDuration.inHours >= 4
                              ? Colors.red
