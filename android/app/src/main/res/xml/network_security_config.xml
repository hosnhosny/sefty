<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- منع HTTP غير المشفر افتراضيًا لكل النطاقات الأخرى -->
    <base-config cleartextTrafficPermitted="false"/>

    <!-- السماح بـ HTTP للسيرفر المحلي فقط (للتطوير) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.1.1.97</domain>
    </domain-config>
</network-security-config>